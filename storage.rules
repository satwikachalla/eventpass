rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /event-documents/{studentUid}/{allPaths=**} {
      // Students can read their own files; staff (proctor, incharge, admin) can read
      allow read: if request.auth != null;

      // Student can only upload to their own folder, max 10MB, PDF and images only
      allow write: if request.auth != null
                   && request.auth.uid == studentUid
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('image/png')
                       || request.resource.contentType.matches('image/jpeg'));
    }
  }
}
